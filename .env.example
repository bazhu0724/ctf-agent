# Competition platform: ctfd, ret2shell, or ctfplus
CTF_PLATFORM=ctfd

# Shared competition URL; CTFD_TOKEN remains supported by both adapters
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# Ret2Shell only
RET2SHELL_TOKEN=
RET2SHELL_GAME_ID=0
RET2SHELL_AUTO_START_INSTANCES=true

# CTF+ only (CTFPLUS_TOKEN is the browser localStorage mario-token value)
CTFPLUS_TOKEN=
CTFPLUS_COMPETITION_ID=
CTFPLUS_PROBLEM_BANK_ID=

# Optional direct-provider keys (not needed for Magpie workers)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Magpie — local OpenAI-compatible gateway; confirm free pool membership in its UI
MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
MAGPIE_API_KEY=magpie-codex

# Per-response output budget and requests per solver run (not a global token cap)
MAGPIE_MAX_TOKENS=8192
SOLVER_REQUEST_LIMIT=100
SOLVER_MAX_BUMPS=2
